#!/data/data/com.termux/files/usr/bin/sh
set -eu

service_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=${OPENBOT_TERMUX_ROOT:-"$(CDPATH= cd -- "$service_dir/../../.." && pwd)"}
mkdir -p "$HOME/.openbot-termux/log"
export OPENBOT_TERMUX_ROOT="$root"
export OPENBOT_TERMUX_DATA_DIR="$HOME/.local/share/openbot-termux"
exec "$root/scripts/termux/openbot-server"
